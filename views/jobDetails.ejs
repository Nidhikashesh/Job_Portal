<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/jobDetails.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

</head>

<body>
    
        <div class="job-card" data-title="Software Engineer">

            <div class="job-logo">
                <img src="../uploads/<%=post.companyLogo%>" class="profile-img">
                <h3>
                    <%=post.jobRole%>
                </h3>
            </div>
            <div class="job-info">
                <h4 class="company">
                    <%=post.companyName%> <br>

                </h4>
                <p class="qualification"><i class="fa-solid fa-graduation-cap"></i><b> Qualifications :</b>
                    <%=post.qualification%>
                </p>
                <p><i class="fa-solid fa-location-dot"></i><b> Location :</b> <%=post.location%>
                </p>
                <p> <i class="fa-solid fa-briefcase"></i><b> Experience :</b> <%=post.experience%>
                </p>
                <p class="job-type"><i class="fa-solid fa-user-tie"></i> <b>Job-type :</b> <%=post.jobType%>
                </p>
                <p class="job-type"><i class="fa-solid fa-calendar-days"></i><b> last date :</b> <%=post.lastDate.toISOString().split('T')[0] %>
                </p>
                <p><b>Job Description :</b> <%=post.description%></p>
                <p><b>Organization Type :</b> <%=post.sector%></p>
            </div>

            <a href="<%=post.applyLink%>"><button class="btn">Apply Now</button></a>
            
        </div>
        
</body>

</html>