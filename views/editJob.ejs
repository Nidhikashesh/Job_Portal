<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>edit Job Post</title>
    <link rel="stylesheet" href="/stylesheets/editJob.css">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>


    <div class="container">
        <h2>Edit Job Post</h2>

        <form action="/posts/<%= job._id %>?_method=PUT" method="POST">

            <label>Description</label>
            <textarea name="description" required><%= job.description %></textarea>

            <label>Last Date</label>
            <input type="text" name="lastDate" value="<%= job.lastDate %>" required>

            <button type="submit">Update Job</button>
        </form>
    </div>


</body>
</html>